# Variables del servicio de runtime de CopilotKit (proceso Node en el VPS).
# Copiar a .env.runtime en el VPS (NO se versiona).

# El servicio corre en producción (resolveAgentUrl usa OVNI_AGENT_URL_PROD).
NODE_ENV=production
PORT=8787

# ── Backend ovni-agent ───────────────────────────────────────────────────────
OVNI_AGENT_URL_PROD=https://api.ovnistudio.com.ar
OVNI_AGENT_ID=
OVNI_CLIENT_ID=

# ── CopilotKit Intelligence ──────────────────────────────────────────────────
CPK_INTELLIGENCE_API_KEY=
COPILOTKIT_LICENSE_TOKEN=
INTELLIGENCE_MEMORY_ENABLED=false

# ── Firestore (leads/ETL). Requerido para que el ETL persista. ───────────────
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Leads ────────────────────────────────────────────────────────────────────
AUTO_SYNC_DISABLED=false
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_AUTH=
LEAD_HOT_THRESHOLD=60

# ── Extras ───────────────────────────────────────────────────────────────────
COPILOTKIT_TELEMETRY_DISABLED=true
