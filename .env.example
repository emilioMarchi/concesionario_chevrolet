# ── Servidor del agente (backend ovni-agent) ─────────────────────────────────
# URL base del servidor que expone /copilotkit. Es SOLO server-side (no expongas
# el backend ni el ngrok al navegador).
#   - Local:  http://localhost:8080
#   - Prod (ngrok): https://<subdominio>.ngrok-free.app
# En producción esta variable es obligatoria: si falta, la API responde 500.
OVNI_AGENT_URL=http://localhost:8080

# Identificadores que se reenvían al backend en cada request (headers
# x-agent-id / x-client-id). El backend resuelve el agente de Firestore.
OVNI_AGENT_ID=
OVNI_CLIENT_ID=

# ── CORS del endpoint /api/copilotkit ────────────────────────────────────────
# Orígenes extra permitidos para llamar a /api/copilotkit desde OTRO dominio
# (el propio dominio siempre funciona por ser same-origin y no necesita esto).
# Lista separada por comas, sin espacios. Usá "*" para permitir todos (no recomendado).
# Dejar vacío = no se habilita ningún origen cruzado.
#   Ej prod: https://mi-sitio.vercel.app,https://mi-dominio.com
#   Ej preview Vercel: https://mi-proyecto-git-rama.vercel.app (listá los exactos, no hay wildcards)
ALLOWED_ORIGINS=
