# ── Servidor del agente (backend ovni-agent) ─────────────────────────────────
# URL base del servidor que expone /copilotkit. Es SOLO server-side (no expongas
# el backend ni el ngrok al navegador). Se elige según NODE_ENV:
#   - Desarrollo: OVNI_AGENT_URL_DEV   (ej. http://localhost:8080)
#   - Producción: OVNI_AGENT_URL_PROD  (ej. https://<subdominio>.ngrok-free.app)
# En producción OVNI_AGENT_URL_PROD es obligatoria: si falta, la API responde 500.
OVNI_AGENT_URL_DEV=http://localhost:8080
OVNI_AGENT_URL_PROD=

# Identificadores que se reenvían al backend en cada request (headers
# x-agent-id / x-client-id). El backend resuelve el agente de Firestore.
OVNI_AGENT_ID=
OVNI_CLIENT_ID=

# ── CORS del endpoint /api/copilotkit ────────────────────────────────────────
# Orígenes extra permitidos para llamar a /api/copilotkit desde OTRO dominio
# (el propio dominio siempre funciona por ser same-origin y no necesita esto).
# Lista separada por comas, sin espacios. Usá "*" para permitir todos (no recomendado).
# Dejar vacío = no se habilita ningún origen cruzado.
#   Ej prod: https://mi-sitio.vercel.app,https://mi-dominio.com
#   Ej preview Vercel: https://mi-proyecto-git-rama.vercel.app (listá los exactos, no hay wildcards)
ALLOWED_ORIGINS=

# ── CopilotKit Intelligence ──────────────────────────────────────────────────
# Project key server-side. Habilita threads durables, memoria y el ETL de leads.
# (La MISMA key también se usa para leer de vuelta threads/mensajes/memorias.)
CPK_INTELLIGENCE_API_KEY=

# Memoria de largo plazo de Intelligence (opt-in). Si tu organización/licencia
# NO la incluye, la plataforma responde 403 MEMORY_NOT_ENTITLED; con este flag
# apagado se omiten las lecturas de memoria y el attach del MCP managed (evita
# el 403 y el warning MCP_NOT_ENABLED). El ETL igual funciona con threads +
# eventos (la calificación se deriva de los mensajes del thread y el recorrido UI).
INTELLIGENCE_MEMORY_ENABLED=false

# ── Persistencia propia del backoffice (Firestore) ───────────────────────────
# Si NO se define ninguna, el store degrada a memoria (no persiste entre procesos).
# Opción A: JSON del service account inline.
FIREBASE_SERVICE_ACCOUNT=
# Opción B: ruta al JSON del service account (mismo que usa ovni-agent).
#   Ej: GOOGLE_APPLICATION_CREDENTIALS=../ovni-agent/agent-firebase-service.json
GOOGLE_APPLICATION_CREDENTIALS=

# ── Backoffice /admin ────────────────────────────────────────────────────────
# Contraseña del panel de leads. Si falta, /admin/login responde 503.
ADMIN_PASSWORD=
# Secreto opcional para el endpoint de ETL programado POST /api/etl/intelligence
# (header `Authorization: Bearer <ETL_SECRET>`). Si falta, el endpoint queda abierto
# para llamadas internas; el backoffice usa /api/admin/sync (protegido por login).
ETL_SECRET=

# ── F6: notificación de leads calientes ──────────────────────────────────────
# Si está definido, al calificar un lead con score >= LEAD_HOT_THRESHOLD (default 60)
# se hace POST una sola vez con { event:'lead.hot', lead, visitor }.
LEAD_WEBHOOK_URL=
# Header Authorization tal cual se envía al webhook (ej. "Bearer xxx").
LEAD_WEBHOOK_AUTH=
# Umbral de score para considerar "hot" (default 60).
LEAD_HOT_THRESHOLD=60

# ── F4: auto-sync ────────────────────────────────────────────────────────────
# Desactiva el ETL diferido que se agenda tras actividad (telemetry / threads).
AUTO_SYNC_DISABLED=false
