# Plantilla de variables para la APP WEB (Next standalone) en el VPS.
# Copiar a `.env.web` y completar. Next.js las lee en runtime (server-side) y las
# que empiezan con NEXT_PUBLIC_ se inlinean en build-time.
#
# IMPORTANTE: el dominio de producción debe apuntar al VPS (ej. concesionario.ovnistudio.com.ar)
# y el runtime de CopilotKit corre en el MISMO host (ver .env.runtime / ecosystem.web/Runtime).

# --- Backend del agente (ovni-agent) ---
OVNI_AGENT_URL_DEV=http://localhost:8080
OVNI_AGENT_URL_PROD=https://api.ovnistudio.com.ar
OVNI_AGENT_ID=agent_f8683390a88e4ab8b357e3e4
OVNI_CLIENT_ID=org_2d8f74a1-b9c5-4e2a-bb6d-f492a8e310d5

# --- CopilotKit Intelligence ---
CPK_INTELLIGENCE_API_KEY=
INTELLIGENCE_MEMORY_ENABLED=false

# --- CopilotKit client ---
# Ya NO hace falta COPILOT_RUNTIME_URL: el runtime se alcanza en el mismo host vía
# /api/copilotkit (ruta relativa). Se deja documentado por si se separa de nuevo.
# COPILOT_RUNTIME_URL=
COPILOT_API_KEY=

# --- CORS (el propio dominio es same-origin; dejar vacío salvo dominios extra) ---
ALLOWED_ORIGINS=

# --- Persistencia propia del backoffice (Firestore) ---
GOOGLE_APPLICATION_CREDENTIALS=/var/www/web_ia/firebase-service-account.json

# --- Backoffice /admin ---
ADMIN_PASSWORD=
ETL_SECRET=

# --- Notificación de leads calientes ---
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_AUTH=
LEAD_HOT_THRESHOLD=60

# --- Auto-sync del ETL ---
AUTO_SYNC_DISABLED=false
